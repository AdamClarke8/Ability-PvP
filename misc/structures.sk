command /b-b:
    permission: op
    trigger:
        set {_target} to target block
        set {_t} to text component from "location(%x-coord of {_target}%, %y-coord of {_target}%, %z-coord of {_target}%, ""lobbies"")"
        add click event to copy "location(%x-coord of {_target}%, %y-coord of {_target}%, %z-coord of {_target}%, ""game"")" to clipboard to {_t}
        broadcast component {_t}