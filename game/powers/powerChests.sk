function spawnPowerChest(l: location, marker: entity, rarity: text = "uncommon"):

    spawn item display at {_l}:
        set {_display} to event-entity
        set item of {_display} to {heads::%{_rarity}%-chest}
        if {_rarity} = "legendary":
            set display scale of {_display} to vector(3.5, 3.5, 3.5)
            set display translation of {_display} to vector(0, 0.75, 0)
            add nbt compound from "{Glowing:1b}" to nbt compound of {_display}
            make {_display} glow orange for all players
            set view range of {_display} to 256
        else:
            set display scale of {_display} to vector(2.5, 2.5, 2.5)
            set display translation of {_display} to vector(0, 0.5, 0)
        set teleport duration of {_display} to 1 tick
        set interpolation duration of {_display} to 1 tick

    spawn interaction at {_l}:
        set {_hitbox} to event-entity
        set interaction width of {_hitbox} to 3
        set interaction height of {_hitbox} to 3
        set {-is-power-chest-interaction::%{_hitbox}%} to true
        set {-power-chest-display::%{_hitbox}%} to {_display}

    set {_angle} to 4.5
    set {_amplitude} to 0.25
    set {_frequency} to 4.5

    while {_display} is alive:

        if {_marker} is not alive:
            kill {_display}
            exit loop

        set interpolation delay of {_display} to 0 ticks
        add {_angle} to yaw of {_l}
        teleport {_display} to location 1 + {_amplitude} * sin(loop-counter * {_frequency}) above {_l}
        draw 1 enchanting particle with offset vector(1, 1, 1) with particle speed 0.5 at {_display}

        loop getPlayers({_l}, 2.5):

            openPowerChest(loop-value, {_rarity})
            play sound "block.chest.open" at volume 3 at pitch 1.2 at {_l}
            play sound "entity.experience_orb.pickup" at volume 2 at pitch 1 at {_l}

            kill {_display}
            exit loop

        #rotate {_display} around y-axis by {_angle} degrees
        wait 1 tick

    kill {_hitbox}

