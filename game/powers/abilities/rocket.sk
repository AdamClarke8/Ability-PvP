options:
    flight-time: 1.25
    warning-radius: 4

function rocketWarningFrame(l: location):


    set {_ring-display} to spawnTextRing({_l}, "&e", {@warning-radius})
    set text of {_ring-display} to "&e⚠"
    set {_orig-scale} to display scale of {_ring-display}
    set {_orig-translation} to display translation of {_ring-display}

    set {_shadow-radius} to {@warning-radius} + 0.5
    set shadow radius of {_ring-display} to {_shadow-radius}
    set {_shadow-strength} to 0
    set shadow strength of {_ring-display} to {_shadow-strength}

    play sound "block.trial_spawner.spawn_item_begin" at volume 3 at pitch 1 at {_l}

    loop {@flight-time} * 20 times:
        set {_radius-factor} to sin(180 * loop-value / ({@flight-time} * 20)) ^ 0.5

        set display scale of {_ring-display} to {_orig-scale} * {_radius-factor}
        set display translation of {_ring-display} to {_orig-translation} * {_radius-factor}
        
        set shadow strength of {_ring-display} to {_shadow-strength} * {_radius-factor}
        set shadow radius of {_ring-display} to {_shadow-radius} * {_radius-factor}

        set pitch of {_l} to -90
        set yaw of {_l} to loop-value * 6
        teleport {_ring-display} to {_l}

        wait 1 tick

    kill {_ring-display}

function rocket(p: player):

    set {-power-active::%{_p}%::rocket} to true
    set {-powers-locked::%{_p}%} to true

    set {_l} to location 2 above {_p}
    set {_range} to {powerAttributes::rocket::range}

    set {_ray} to ray trace from {_p} with max distance {_range}
    if hit location of {_ray} is set:
        set {_target} to hit location of {_ray}
    else:
        set {_target} to getTargetLocation({_p}, {_range}) ? getFloorBlock(location {_range} infront of {_p})

    rocketWarningFrame(location 0.5 above {_target})

    set {_displays::*} to buildingToDisplay({structure::rocket::1}, {structure::rocket::2}, {structure::rocket::centre}, 1, {_l})
    set {_root} to {_displays::1}

    spawn block display at location 2 above {_l}:
        set {_seat} to event-entity
        set {-is-rocket-seat::%{_seat}%} to true

    make {_p} ride {_seat}
    send action bar " " to {_p}
    applyInvis({_p})

    set {_v} to vector from {_l} to {_target}

    set {_hori-v} to {_v}
    set y component of {_hori-v} to 0
    set {_vel-hori} to vector length of {_hori-v}

    set vector length of {_hori-v} to (vector length of {_hori-v}) / (20 * {@flight-time})

    set {_h} to (y component of {_v}) - 2.5
    # u = 10, t = {@flight-time}, s = h, a = ?
    # s = ut + 1/2at^2
    # h = ut + 1/2at^2
    # a = (2 / t^2) * (h - ut)

    set {_init-vel-vert} to 50
    #set {_final-vel-vert} to -10

    set {_accel} to (2 / ({@flight-time} ^ 2)) * ({_h} - {_init-vel-vert} * {@flight-time})
    set {_yaw} to yaw of {_p}

    set {_vel-vert} to {_init-vel-vert}

    set {_temp-l} to {_l}

    play sound "entity.horse.armor" at volume 3 at pitch 1.2 at {_p}

    loop {@flight-time} * 20 times:

        if {_p} is not alive:
            exit loop

        if mod(-1 + loop-value, 5) = 0:
            loop circle({_temp-l}, 2, 10, {_yaw}, ({_pitch} + 90) * -1):
                #draw 0 flame particle with offset (vector from {_temp-l} to loop-value-2) with particle speed 0.5 at {_temp-l}
                draw 0 campfire cosy smoke particle with offset (vector from {_temp-l} to loop-value-2) with particle speed 0.5 at {_temp-l}

            draw 5 flame particle with particle speed 1 at {_temp-l}
            draw 1 black flash particle at {_temp-l}

        play sound "entity.phantom.flap" at volume 3 at pitch 1.2 at {_p}
    
        #play sound "block.wooden_trapdoor.close" at volume 2 at pitch 1.2 at {_p}
        play sound "entity.iron_golem.attack" at volume 2 * loop-value / ({@flight-time} * 20) at pitch 1.5 - 1 * loop-value / ({@flight-time} * 20) at {_p}
        play sound "entity.breeze.charge" at volume 2 at pitch 1 + 0.75 * loop-value / ({@flight-time} * 20) at {_p}
        set {_y-diff} to (y-coord of {_temp-l} - y-coord of {_l})

        play sound "block.note_block.didgeridoo" at volume 3 at pitch 1.5 - 1 * loop-value / ({@flight-time} * 20) at {_p}

        set {_temp-l} to location {_vel-vert} / 20 above {_temp-l} ~ {_hori-v}
        teleport {_root} to {_temp-l}
        teleport {_seat} to location 2 above {_temp-l}
        set {_pitch} to atan({_vel-vert} / {_vel-hori}) * -1
        rotateOnRollAxis({_displays::*}, min(loop-value * 3, 36), vector(0, 0, 1))
        rotate({_root}, {_yaw}, {_pitch}, false)
        wait 1 tick
        set {_vel-vert} to {_vel-vert} + {_accel} / 20

    set {_impact-l} to {_temp-l}

    loop getLivingEntities({_p}, {_impact-l}, 8) where [input != {_p}]:
        makeDamage({_p}, loop-value, {powerAttributes::rocket::damage}, "rocket")

    create explosion of force 2 at {_impact-l}
    spawnFloatingBlockCluster(location 0.5 below {_impact-l}, {heads::gray-orb}, 8, 7, 30, 0.3)
    fallingDebris({_impact-l}, 4, 1.25)

    play sound "block.respawn_anchor.deplete" at volume 3 at pitch 1.2 at {_impact-l}
    play sound "item.trident.thunder" at volume 2 at pitch 2 at {_impact-l}
    play sound "block.fire.extinguish" at volume 2 at pitch 1.2 at {_impact-l}

    kill {_root}
    kill {_seat}

    removeInvis({_p})

    delete {-power-active::%{_p}%::rocket}
    delete {-powers-locked::%{_p}%}

on dismount:
    if {-is-rocket-seat::%vehicle of event-entity%} = true:
        cancel event