function spawnLaserDisplay(l: location, blockData: block data) :: entity:
    spawn block display at {_l}:
        set {_display} to event-entity
        set block data of {_display} to {_blockData}
        set sky light override of {_display} to 15
        set display scale of {_display} to vector(1, 1, 4)
        set display translation of {_display} to vector(-0.5, -0.5, -2)
        set teleport duration of {_display} to 1 tick
    return {_display}

function dave9000Laser(p: player):
    laserEye({_p}, 1)
    laserEye({_p}, -1)

function laserEye(p: player, offset: number):

    play sound "entity.illusioner.prepare_blindness" at volume 2 at pitch 1.2 at {_p}

    set {_l} to location {_offset} left of location 1.7 above {_p}
    set {_tempLoc} to {_l}
    set {_vel} to 2

    chance of 50%:
        set {_laser} to spawnLaserDisplay({_l}, red stained glass)
    else:
        set {_laser} to spawnLaserDisplay({_l}, orange stained glass)

    while {except::*} contains block at {_tempLoc}:

        set interpolation delay of {_laser} to 0 ticks

        loop-counter >= 50:
            exit loop
    
        loop 4 times:
            set {_tempLoc} to location {_vel} / 4 infront of {_tempLoc}
            set {_targets::*} to getLivingEntities({_p}, {_tempLoc}, 3) where [input != {_p}]
            {_targets::*} is set:
                exit all loops

        teleport {_laser} to {_tempLoc}

        play sound "block.note_block.bit" at volume 1.25 at pitch 1.2 at {_tempLoc}

        wait 1 tick

    kill {_laser}
    set {_targetBlock} to block at {_tempLoc}

    set {_targets::*} to getLivingEntities({_p}, {_tempLoc}, 3) where [input != {_p}]
    loop {_targets::*}:
        makeDamage({_p}, loop-value, {powerAttributes::dave-9000::laser-damage}, "dave-9000;laser")
    
    size of (block displays in radius 1 of {_tempLoc} where [block data of input = block data of {_targetBlock}]) = 0:
        draw 1 explosion particle at {_targetBlock}
        draw 1 lava particle at {_targetBlock}
        groundShake({_targetBlock})
    
        throwOutFallingBlock({_targetBlock}, "up", 0.5)

        chance of 33%:
            spawnFloatingBlockCluster({_targetBlock}, {heads::light-gray-orb}, 2, 1.5, 60, 0.5, 0.1)

    play sound "entity.generic.explode" at volume 2 at pitch 1.2 at {_targetBlock}

    {_targets::*} is set:
        chance of 50%:
            play sound "entity.ravager.celebrate" at volume 3 at pitch 1.5 at {_p}

function dave9000SpawnFrame(p: player, l: location):
    while {-winding-up::%{_p}%::dave-9000} = true:
        loop 36 times:
            set {_v} to spherical vector radius 4, yaw loop-counter-1 * 36 + loop-value-2, pitch 0
            set {_l2} to {_l} ~ {_v}
            if mod(loop-value, 2) = 0:
                draw 1 rgb(105, 104, 104) dust particle of size 2.5 at {_l2}
                draw 1 enchanting particle at {_l2}
            else:
                draw 1 rgb(77, 76, 76) dust particle of size 2.5 at {_l2}
                draw 1 netherite block block particle at {_l2}
            if mod(loop-value, 9) = 0:
                draw 1 flame particle with particle speed 0.05 at {_l2}

        play sound "entity.breeze.land" at volume 3 at pitch 0.5 + loop-counter / 60 at {_l2}
        play sound "entity.illusioner.prepare_mirror" at volume 1 at pitch 0.5 + loop-counter / 60 at {_l2}

        if loop-counter < 60:

            if mod(loop-counter, 4) = 0:
                play sound "entity.wither.break_block" at volume 2 at pitch 1.2 at {_l2}

            if mod(loop-counter, 2) = 0:
                chance of 10%:
                    play sound "block.anvil.place" at volume 2 at pitch 1.2 at {_l2}
                chance of 10%:
                    play sound "entity.villager.work_fletcher" at volume 2 at pitch 1.2 at {_l2}
                chance of 10%:
                    play sound "entity.villager.work_mason" at volume 2 at pitch 1.2 at {_l2}
                chance of 10%:
                    play sound "block.piston.extend" at volume 2 at pitch 1.2 at {_l2}
                chance of 10%:
                    play sound "item.trident.hit_ground" at volume 2 at pitch 1.2 at {_l2}
                chance of 10%:
                    play sound "block.iron_trapdoor.close" at volume 2 at pitch 1.2 at {_l2}

        else if loop-counter = 65:
            play sound "item.trident.thunder" at volume 3 at pitch 2 at {_l}
            draw 1 black flash particle at location 3.5 above {_l}

        wait 1 tick

