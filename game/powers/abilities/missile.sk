#        rotateOnRollAxis({_missileDisplays::*}, {_angle}, 15)

#        wait 1 tick

#command /setrot <number> <number>:
#    trigger:
#        set {yaw} to arg-1
#        set {pitch} to arg-2

function missile(p: player):

    set {_loc} to location 1.3 above location 2 infront of {_p}
    set {_missileDisplays::*} to buildingToDisplay({structure::missile::1}, {structure::missile::2}, {structure::missile::centre}, 1, {_loc})
    set view range of {_missileDisplays::*} to 0
    set {_root} to {_missileDisplays::1}
    set {_angle} to 0

    set {_velocity} to 0.25
    rotate({_root}, {_p}'s yaw, {_p}'s pitch, false)

    draw 1 explosion particle at {_loc}
    play sound "entity.generic.explode" at volume 3 at pitch 0.8 at {_loc}
    play sound "entity.breeze.shoot" at volume 3 at pitch 1.2 at {_loc}
    play sound "entity.iron_golem.repair" at volume 2 at pitch 0.8 at {_loc}

    while {_root} is alive:

        if loop-counter >= 100:
            exit loop

        else if {except::*} does not contain block at {_root}:
            exit loop

        else:
            set {_targets::*} to getLivingEntities({_p}, {_root}'s location, 4) where [input != {_p}]
            {_targets::*} is set:
                exit loop

        set {_angle} to min(24, loop-counter * 2)

        add 0.05 to {_velocity}

        teleport {_root} to location {_velocity} infront of {_root}

        set {_tempLoc} to location of {_root}

        rotateOnRollAxis({_missileDisplays::*}, {_angle}, vector(0, 0, 1))

        play sound "block.note_block.didgeridoo" at volume 2 at pitch 0.5 + min(loop-counter / 20, 1) at {_tempLoc}
        #play sound "block.note_block.bit" at volume 2 at pitch 1 + min(loop-counter / 20, 1) at {_root}
        play sound "entity.breeze.charge" at volume 2 at pitch 1.5 + min(loop-counter / 40, 1) at {_tempLoc}

        if mod(loop-counter, 10) = 0:
            loop circle({_tempLoc}, 2, 10, (yaw of {_tempLoc}), (pitch of {_tempLoc} + 90) * -1):
                draw 0 smoke particle with offset (vector from {_root} to loop-value) with particle speed 0.25 at loop-value
            draw 1 black flash particle at {_tempLoc}

        wait 1 tick

        if loop-counter = 1:
            set view range of {_missileDisplays::*} to 128

    create explosion of force 2 at {_tempLoc}
    play sound "block.respawn_anchor.deplete" at volume 3 at pitch 1.2 at {_tempLoc}
    kill {_root}

    loop {_targets::*}:
        makeDamage({_p}, loop-value, {powerAttributes::missile::damage}, "missile")
        applyPush(loop-value, (normalized vector from {_p} to loop-value) + vector(0, 0.5, 0), {_p}, "missile")