options:
    time-until-results: 140
    winner-fragments: 25
    loser-fragments: 10

    reward-prefix: &a&lREWARD &7»

function endTeamDeathmatch(lobby: text):
    set {team-deathmatch::%{_lobby}%} to false
    delete {-points::%{_lobby}%::team-deathmatch::*}
    delete {-kills::%{_lobby}%::team-deathmatch::*}
    delete {-deaths::%{_lobby}%::team-deathmatch::*}
    delete {-damage-dealt::%{_lobby}%::team-deathmatch::*}
    delete {-damage-taken::%{_lobby}%::team-deathmatch::*}
    delete {-gamemode::%{_lobby}%}
    cleanUpPlayers({_lobby}, getPlayers({_lobby}))
    cleanUpMap({_lobby}, getCurrentMap({_lobby}))
    clearTeam({_lobby}, "blue")
    clearTeam({_lobby}, "red")

local function awardWinners(winners: players):
    loop {_winners::*}:
        add {@winner-fragments} to {fragments::%loop-value%}
        sidebar(loop-value, "fragments")
        send "{@reward-prefix} &b+{@winner-fragments} Fragments" to loop-value

local function awardLosers(losers: players):
    loop {_losers::*}:
        add {@loser-fragments} to {fragments::%loop-value%}
        sidebar(loop-value, "fragments")
        send "{@reward-prefix} &b+{@loser-fragments} Fragments" to loop-value

function declareWinnerTeamDeathmatch(lobby: text, side: text):

    set {team-deathmatch::%{_lobby}%} to false

    set {_blue-players::*} to getPlayersOnTeam({_lobby}, "blue")
    set {_red-players::*} to getPlayersOnTeam({_lobby}, "red")

    if {_side} = "blue":
        set {_text::*} to nl, "&a① &7»", "&9&lBLUE", "&fhas won! &7(%{-points::%{_lobby}%::team-deathmatch::blue}% points)" and nl

        sendWinnerTitle({_blue-players::*})
        sendLoserTitle({_red-players::*})

        awardWinners({_blue-players::*}, "team-deathmatch")
        awardLosers({_red-players::*}, "team-deathmatch")


    else if {_side} = "red":
        set {_text::*} to nl, "&a① &7»", "&c&lRED", "&fhas won! &7(%{-points::%{_lobby}%::team-deathmatch::red}% points)" and nl

        sendWinnerTitle({_red-players::*})
        sendLoserTitle({_blue-players::*})

        awardWinners({_red-players::*}, "team-deathmatch")
        awardLosers({_blue-players::*}, "team-deathmatch")

    awardForKills({_lobby}, "team-deathmatch")
    awardForAssists({_lobby}, "team-deathmatch")

    set {_text} to merge components {_text::*} with " "
    send component {_text} to getPlayersInLobby({_lobby})
    play sound "event.raid.horn" at volume 3 at pitch 1.2 to getPlayersInLobby({_lobby})
    play sound "ui.toast.challenge_complete" at volume 3 at pitch 1 to getPlayersInLobby({_lobby})
    cleanUpPlayers({_lobby}, getPlayers({_lobby}))
    cleanUpMap({_lobby}, getCurrentMap({_lobby}))
    wait {@time-until-results} ticks
    startResults({_lobby})
    wait 5 ticks
    while {-showing-results::%{_lobby}%} = true:
        wait 1 tick
    endTeamDeathmatch({_lobby})

function startTeamDeathmatch(lobby: text, ticks: number = 3 * 60 * 20):

    set {-orig-players::%{_lobby}%::*} to getPlayers({_lobby})

    set {team-deathmatch::%{_lobby}%} to true
    set {-gamemode::%{_lobby}%} to "team-deathmatch"

    #set {team-deathmatch-req-points} to {_points}
    set {-time-left::%{_lobby}%::team-deathmatch} to {_ticks}
    set {-max-time::%{_lobby}%::team-deathmatch} to {_ticks}

    loop getPlayers({_lobby}):
        if mod(loop-counter, 2) = 0:
            addToTeam(loop-player, "red")
            make loop-player glow red for all players
        else:
            addToTeam(loop-player, "blue")
            make loop-player glow blue for all players
        resetPlayerMatch(loop-player)
        sidebar(loop-player)

    loadPowerChests({_lobby}, getCurrentMap({_lobby}))
    loadPartyCannons({_lobby}, getCurrentMap({_lobby}))

    loop 100 times:
        wait 1 tick

    giveStartingPowers({_lobby})


    set {-points::%{_lobby}%::team-deathmatch::blue} to 0
    set {-points::%{_lobby}%::team-deathmatch::red} to 0

    set {_l} to location 1 above getCurrentMapCentre({_lobby})

    set yaw of {_l} to 0
    set pitch of {_l} to 0

    spawn text display at location 3 above {_l}:
        set {_text-display} to event-entity
        set text of {_text-display} to ""
        set display scale of {_text-display} to vector(4, 4, 4)
        set line width of {_text-display} to 1000
        set billboard of {_text-display} to vertical

    #set {_radius} to 5
    #set {_ring-display} to spawnTextRing(block at {_l}, "&c", {_radius})

    while {team-deathmatch::%{_lobby}%} = true:

        if size of getPlayers({_lobby}) = 0:
            exit loop

        #set {_prev-players::*} to {_current-players::*}
        #set {_current-players::*} to all players where [{-kills::%{_lobby}%::team-deathmatch::%input%} > 0]


        #loop {_current-players::*}:
        #
        #    if {-kills::%{_lobby}%::team-deathmatch::%loop-value%} >= {_req-kills}:
        #        set {_player-head} to object text component with player head from loop-value
        #        set {_text::*} to nl, "&a① &7»", "&a&l%loop-value%", {_player-head}, "&fhas won! &7(%{_req-kills}% kills)" and nl
        #        set {_text} to merge components {_text::*} with " "
        #        broadcast component {_text}
        #        loop players:
        #            broadcast "&a%loop-value-2%: &f%{-kills::%{_lobby}%::team-deathmatch::%loop-value-2%} ? 0% Kills&7, &f%{-damage-dealt::%{_lobby}%::team-deathmatch::%loop-value-2%} ? 0% Damage Dealt&7, &f%{-damage-taken::%{_lobby}%::team-deathmatch::%loop-value-2%} ? 0% Damage Taken"
        #        broadcast ""
        #        play sound "event.raid.horn" at volume 3 at pitch 1.2 at {_l}
        #        play sound "ui.toast.challenge_complete" at volume 3 at pitch 1 at {_l}
        #        endTeamDeathmatch()
        #        exit all loops
        
        if mod((loop-counter) - 1, 20) = 0:

            if {-points::%{_lobby}%::team-deathmatch::blue} >= {-points::%{_lobby}%::team-deathmatch::red}:
                set {_first} to "&9&lBLUE &7» &a%{-points::%{_lobby}%::team-deathmatch::blue}%"
                set {_second} to "&c&lRED &7» &a%{-points::%{_lobby}%::team-deathmatch::red}%"

            else:
                set {_first} to "&c&lRED &7» &a%{-points::%{_lobby}%::team-deathmatch::red}%"
                set {_second} to "&9&lBLUE &7» &a%{-points::%{_lobby}%::team-deathmatch::blue}%"

            set {_text} to merge components ({_first} and {_second}) joined with nl
        
            #set {_objective} to toSmallFont("OBJECTIVE: 1000 POINTS")
            set {_leaderboard} to toSmallFont("LEADERBOARD")
            #set {_prefix::*} to "&b%{_objective}%", "&e%{_leaderboard}%"
            #set {_prefix::*} to "&bOBJECTIVE: %{_points}% POINTS", "&e%{_leaderboard}%"
            if mod({_ticks-left}, 20) = 0:
                set {_prefix::*} to "&bTIME REMAINING: %getTimeLeftFormatted({_lobby})%", "&e%{_leaderboard}%"
                sidebar(getPlayersInLobby({_lobby}), "time-left")

            set {_text} to merge components ({_prefix::*} and {_text}) with nl
            set display text component of {_text-display} to {_text}

        #set interpolation delay of {_ring-display} to 0 ticks
        #add 3 to yaw of {_ring-display}
        
        wait 1 tick
        set {-time-left::%{_lobby}%::team-deathmatch} to {-time-left::%{_lobby}%::team-deathmatch} - 1
        set {_ticks-left} to {-time-left::%{_lobby}%::team-deathmatch}

        if {_ticks-left} = 2400:
            warnMinutesLeft(getPlayersInLobby({_lobby}), 2)

        else if {_ticks-left} = 1200:
            warnMinutesLeft(getPlayersInLobby({_lobby}), 1)

        else if {_ticks-left} = 200:
            startMatchCountdown(getPlayersInLobby({_lobby}))

        else if {_ticks-left} <= 0:
            if {-points::%{_lobby}%::team-deathmatch::blue} >= {-points::%{_lobby}%::team-deathmatch::red}:
                declareWinnerTeamDeathmatch({_lobby}, "blue")
            else if {-points::%{_lobby}%::team-deathmatch::red} > {-points::%{_lobby}%::team-deathmatch::blue}:
                declareWinnerTeamDeathmatch({_lobby}, "red")

    kill {_text-display}
    #kill {_ring-display}

command /start-team-deathmatch <number>:
    permission: op
    trigger:
        startTeamDeathmatch(getLobby(player), 20 * 60 * arg)

command /end-team-deathmatch:
    permission: op
    trigger:
        endTeamDeathmatch(getLobby(player))
